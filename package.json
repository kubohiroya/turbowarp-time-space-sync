{
  "name": "@kubohiroya/turbowarp-time-space-sync",
  "version": "0.4.0",
  "description": "時刻対応とカメラ配置の校正 for TurboWarp.",
  "author": "Hiroya Kubo <hiroya@cuc.ac.jp>",
  "license": "MPL-2.0",
  "homepage": "https://github.com/kubohiroya/turbowarp-time-space-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/turbowarp-time-space-sync.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/turbowarp-time-space-sync/issues"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "extension",
    "time-space-sync",
    "typescript",
    "webgpu"
  ],
  "type": "module",
  "exports": {
    "./runtime": {
      "types": "./lib/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./package.json": "./package.json",
    "./editor-schema": {
      "types": "./lib-editor/src/editor-schema.d.ts",
      "import": "./lib-editor/src/editor-schema.js"
    }
  },
  "sideEffects": [
    "src/index.ts",
    "dist/*"
  ],
  "files": [
    "assets/",
    "dist/",
    "lib/",
    "docs/",
    "schemas/",
    "fixtures/",
    "src/",
    "templates/",
    "README.md",
    "README.ja.md",
    "LICENSE",
    "lib-editor/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.lib.json && npm run build:editor",
    "prepack": "pnpm run build",
    "lint": "eslint src tests scripts vite.config.ts",
    "test": "vitest run",
    "docs": "node scripts/generate-readme.ts && node scripts/generate-fixed-input-docs.mjs",
    "schemas": "node scripts/generate-schemas.ts",
    "schemas:check": "node scripts/generate-schemas.ts --check",
    "fixtures": "node scripts/generate-fixtures.ts",
    "fixtures:check": "node scripts/generate-fixtures.ts --check",
    "docs:check": "pnpm run docs && git diff --exit-code -- README.md",
    "template:readme": "node scripts/apply-readme-template.ts",
    "repo:check": "node scripts/check-repo.ts",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run docs:check && pnpm run schemas:check && pnpm run fixtures:check && pnpm run check:dist && pnpm run repo:check && pnpm run pack:check",
    "check:dist": "pnpm run build && node scripts/check-dist.ts",
    "build:editor": "tsc -p tsconfig.editor.json",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@kubohiroya/turbowarp-extension-manifest": "^0.3.2",
    "@kubohiroya/vite-plugin-turbowarp-extension": "^0.8.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "@kubohiroya/turbowarp-camera-source": "^0.20.0",
    "@kubohiroya/turbowarp-extension-data-editor": "^0.3.4"
  }
}
